# TrustGate — Constitution Guard (LLM judge) configuration.
# Copy to .env and fill in. The .env file is gitignored; never commit real keys.
#
# The judge is provider-agnostic. OpenRouter and Groq are both OpenAI-compatible,
# so they need only a base URL + model id. Anthropic and local backends use the
# same interface.

# One of: fake | openrouter | groq | anthropic | local
# `fake` is the default and requires no network or key — it is what the test
# suite and the red-team runner use so they stay deterministic and free.
TRUSTGATE_JUDGE_PROVIDER=fake

# --- OpenRouter (https://openrouter.ai/keys) ---
# Free-tier model ids carry a ":free" suffix and change often; check
# https://openrouter.ai/models?q=free for what is currently available.
OPENROUTER_API_KEY=
TRUSTGATE_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
TRUSTGATE_GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic (later) ---
ANTHROPIC_API_KEY=
TRUSTGATE_ANTHROPIC_MODEL=claude-sonnet-5

# --- Local (Ollama / llama.cpp / vLLM, OpenAI-compatible endpoint) ---
TRUSTGATE_LOCAL_BASE_URL=http://localhost:11434/v1
TRUSTGATE_LOCAL_MODEL=llama3.3

# Seconds before a judge call is abandoned. On timeout the engine fails safe
# (escalates on critical principles) rather than silently allowing.
TRUSTGATE_JUDGE_TIMEOUT=4.0
